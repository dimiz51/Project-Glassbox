# Copy to .env (cp .env.example .env). Docker compose and the local backend both read it.

# --- LLM (Ollama, running on your machine with `ollama serve`) ---
# Local run: http://localhost:11434 · inside Docker this is overridden to host.docker.internal
OLLAMA_BASE_URL=http://localhost:11434
# Any Ollama vision model: qwen3.5:9b (default), qwen3.5:4b (smaller/faster), qwen3.8:27b (best, ~17GB)
OLLAMA_MODEL=qwen3.5:9b
# Context window; each step sends one screenshot (~1k tokens) + page text
OLLAMA_NUM_CTX=16384
# >1 penalises repeating tokens within one output (1.0 = off)
OLLAMA_REPEAT_PENALTY=1.1
# true = model thinks before answering: better decisions, much slower steps
OLLAMA_THINK=false
# false = text-only models (no screenshot sent, only element list + page text)
USE_VISION=true

# --- Sandbox browser ---
# Local run: true = no window. false = a separate Chromium window opens (still not your own browser/profile)
HEADLESS=true
MAX_STEPS=30
