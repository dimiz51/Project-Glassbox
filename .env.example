# Copy to .env (cp .env.example .env). Docker compose and the local backend both read it.

# --- LLM: OpenAI (optional) ---
# Set BOTH to use OpenAI instead of Ollama; leave either empty to use Ollama.
# Any OpenAI vision model with structured outputs, e.g. gpt-4.1-mini
OPENAI_API_KEY=
OPENAI_MODEL=

# --- LLM: OpenRouter (optional, any open or closed model through one key) ---
# Set BOTH to use OpenRouter instead of Ollama (OpenAI wins if both pairs are set).
# Needs a vision model that supports structured outputs: https://openrouter.ai/models?modality=image&supported_parameters=structured_outputs
# e.g. qwen/qwen3-vl-32b-instruct, google/gemini-2.5-flash, openai/gpt-4.1-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# --- LLM: Ollama (default, running on your machine with `ollama serve`) ---
# Local run: http://localhost:11434 · inside Docker this is overridden to host.docker.internal
OLLAMA_BASE_URL=http://localhost:11434
# Any Ollama vision model: qwen3.5:9b (default), qwen3.5:4b (smaller/faster), qwen3.8:27b (best, ~17GB)
OLLAMA_MODEL=qwen3.5:9b
# Context window; each screenshot sent is ~1–1.5k tokens
OLLAMA_NUM_CTX=16384
# >1 penalises repeating tokens within one output (1.0 = off)
OLLAMA_REPEAT_PENALTY=1.1
# true = model thinks before answering: better decisions, much slower steps
OLLAMA_THINK=false
# The model sees the task as a conversation of its steps: the latest HISTORY_MESSAGES messages.
# The newest HISTORY_IMAGES screenshots are sent as images (current screen + the ones before it).
# 0 = text-only: no screenshots at all, the model works from the element list. Needed for text-only
# models (e.g. inception/mercury-3 on OpenRouter); a vision model does better with the screenshots.
HISTORY_MESSAGES=10
HISTORY_IMAGES=3

# --- Sandbox browser ---
# Local run: true = no window. false = a separate Chromium window opens (still not your own browser/profile)
HEADLESS=true
MAX_STEPS=30

# --- Tracing (Langfuse, optional) ---
# Off unless both keys are set. Get them in your Langfuse project: Settings -> API Keys.
# Each task is one trace (grouped by chat session) with every model call, its screenshot and each action.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Langfuse Cloud: https://cloud.langfuse.com (EU) or https://us.cloud.langfuse.com (US).
# Self-hosted on your machine: http://localhost:3000 for a local run, but from inside Docker use
# http://host.docker.internal:<port> (and pick a port other than 3000, which the Glassbox UI uses)
LANGFUSE_BASE_URL=https://cloud.langfuse.com
